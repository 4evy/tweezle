{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':semanticCommits',
    ':semanticCommitTypeAll(bump)',
  ],
  automerge: true,
  automergeType: 'branch',
  internalChecksAsSuccess: true,
  statusCheckWhen: {
    artifactError: 'always',
  },
  prCreation: 'approval',
  dependencyDashboard: {
    enabled: false,
  },
  packageRules: [
    {
      matchManagers: [
        'gomod',
      ],
      postUpdateOptions: [
        'gomodUpdateImportPaths',
        'gomodTidy',
      ],
    },
    {
      matchManagers: [
        'gomod',
        'nix',
      ],
      postUpgradeTasks: {
        commands: [
          "nix --extra-experimental-features 'nix-command flakes' run --inputs-from . nixpkgs#nix-update -- --flake --version=skip --build tweezle",
        ],
        fileFilters: [
          'nix/package.nix',
        ],
        executionMode: 'branch',
      },
    },
  ],
  nix: {
    enabled: true,
  },
}
